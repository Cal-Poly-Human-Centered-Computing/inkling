    "@types/d3-time": "^3.0.4",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
